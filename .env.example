# Kopieren nach .env und ausfüllen. .env wird nie eingecheckt.

# Supabase: lokal nicht nötig, die CLI stellt diese Werte selbst bereit. Nur für den Server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Lokal und in der Testumgebung nur Schlüssel aus dem Testmodus (sk_test_...).
STRIPE_SECRET_KEY=
# Lokal: der Wert whsec_..., den "stripe listen" beim Start ausgibt.
STRIPE_WEBHOOK_SECRET=

# Adresse des Portals. Lokal: http://127.0.0.1:5173
PORTAL_URL=https://my.onboard-germany.de

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=
